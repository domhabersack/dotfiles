#!/bin/sh
# Starts a background fswatch watcher that re-runs tmux-color-windows whenever
# the window-colors config file is saved. Single-instance guarded per tmux
# server, and exits with the server that started it (see bin/tmux-watchlib):
# safe to call on every config reload.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

CONFIG="$HOME/.dotfiles/window-colors"
INTERVAL=30

command -v fswatch >/dev/null 2>&1 || exit 0
[ -f "$CONFIG" ] || exit 0

# Exported so the watcher child inherits it: the body below is single-quoted on
# purpose, so $CONFIG must expand in the child rather than here.
export CONFIG

# fswatch runs in the background and the watcher waits on watch_alive instead of
# on fswatch, rather than the other way round. Reading fswatch's output directly
# would mean the only chance to notice a dead server is the next time the file
# changes -- which for a config file can be months -- and fswatch itself would be
# left running regardless, since it exits only when something writes to a closed
# pipe. (fswatch's own --one-event does not help: it prints the event and keeps
# running.) Events are still handled the moment they arrive: nothing here polls
# the file, and the library's exit handler reaps both children.
#
# The loop also watches the pipeline itself. Backgrounding fswatch means nothing
# supervises it, and a watcher whose fswatch had died would sit there looking
# healthy to the guard, so no reload could replace it and the colours would just
# stop updating. $! is the pipeline's reading end, which gets EOF and exits when
# fswatch goes, making it a faithful stand-in for "is this still working".
# Ending the loop lets the next reload start a fresh one.
# shellcheck disable=SC2016 # single-quoted on purpose: $CONFIG/$INTERVAL expand in the child
watch_spawn tmux-color-watch \
  'fswatch -o "$CONFIG" | while read -r _; do
     ~/.dotfiles/bin/tmux-color-windows
   done &
   pipeline=$!
   while watch_alive && kill -0 "$pipeline" 2>/dev/null; do
     sleep '"$INTERVAL"'
   done'
