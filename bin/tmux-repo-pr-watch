#!/bin/sh
# Starts a background ticker that re-runs tmux-repo-pr on a fixed interval, so
# a `cd` into a different repo with no window/pane-switch event to trigger a
# re-render still gets picked up within one tick, and stale per-repo caches
# get refreshed even when idle. Single-instance guarded: safe to call on
# every config reload.

PIDFILE=/tmp/tmux-repo-pr-watch.pid
INTERVAL=60

# Reuse the running ticker if it is still alive.
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  exit 0
fi

nohup sh -c \
  'while :; do ~/.dotfiles/bin/tmux-repo-pr; sleep '"$INTERVAL"'; done' \
  >/dev/null 2>&1 &

echo $! > "$PIDFILE"
