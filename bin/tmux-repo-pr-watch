#!/bin/sh
# Starts a background ticker that re-runs tmux-repo-pr on a fixed interval, so a
# `cd` into a different repo with no window/pane-switch event to trigger a re-
# render still gets picked up within one tick, and stale per-repo caches get
# refreshed even when idle. Single-instance guarded per tmux server, and exits
# with the server that started it (see bin/tmux-watchlib): safe to call on every
# config reload.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

INTERVAL=60

# watch_alive as the loop condition, not `while :`, so this exits once the
# tmux server that started it is gone rather than ticking forever.
watch_spawn tmux-repo-pr-watch \
  'while watch_alive; do ~/.dotfiles/bin/tmux-repo-pr; sleep '"$INTERVAL"'; done'
