#!/bin/sh
# ccusage lives under nvm's per-version bin dir, which isn't on PATH in the
# non-interactive shell tmux spawns for a popup; source nvm.sh to pick up the
# default version before invoking it.
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091 # external file, not part of this repo
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# --since caps the report at (up to) the last six months; --since just
# filters, so a vault with less history than that renders exactly what
# exists, no error. No --breakdown here -- the per-model split lives in the
# companion prefix+U popup (bin/tmux-ccusage-models-popup) instead, so this
# view stays a single, uncluttered monthly-totals table.
ccusage claude monthly --since "$(date -v-6m -v1d +%Y%m%d)"
