#!/bin/sh
# Reads the local mailbox (MAIL, default /var/mail/<user>) and prints one line
# per message, oldest first, fields separated by the ASCII unit separator
# (\037) so a subject containing spaces, tabs or punctuation stays intact:
#
#   <index> US <U|R> US <sender> US <date> US <subject>
#
#   index    1-based position in the file, the same numbering BSD mail uses, so
#            bin/tmux-mail-action can address the message with it
#   U|R      U when the message hasn’t been read (its Status: header has no R,
#            which is also the case for a message with no Status: header at
#            all), R when it has
#   sender   the local part of the From: header’s address (agent@host -> agent),
#            falling back to the envelope sender
#   date     the envelope date, "Nov 3 14:09", in local time
#
# With `--body N`, prints message N instead -- From/Date/Subject, a blank line,
# then its body -- for the popup’s preview pane. Both modes only ever read the
# mailbox; changes go through mail itself (bin/tmux-mail-action), which takes
# the lock postfix delivers under.
#
# Messages are split on envelope "From " lines that follow a blank line (or
# start the file), not on any line starting with "From ": a body line that
# happens to start that way is escaped to ">From " by the local delivery agent,
# and this check keeps one that wasn’t from splitting a message in two.
set -eu

mbox=${MAIL:-/var/mail/$(id -un)}

# No mailbox yet is the normal state of a machine nobody has mailed: nothing
# to list, not an error.
[ -r "$mbox" ] || exit 0

mode=list
want=0
if [ "${1:-}" = --body ]; then
  mode=body
  want=${2:?usage: tmux-mail-feed [--body N]}
fi

awk -v mode="$mode" -v want="$want" '
BEGIN { us = sprintf("%c", 31); n = 0; prevblank = 1 }

function sender_of(from, env,   a) {
  a = from
  if (match(a, /<[^>]*>/)) a = substr(a, RSTART + 1, RLENGTH - 2)
  sub(/@.*/, "", a)
  gsub(/^[ \t"]+|[ \t"]+$/, "", a)
  if (a == "") { a = env; sub(/@.*/, "", a) }
  if (a == "") a = "unknown"
  return a
}

function value_of(header) {
  sub(/^[^:]*:[ \t]*/, "", header)
  return header
}

function finish(   st, subj) {
  if (n == 0 || mode != "list") return
  st = value_of(status)
  subj = value_of(subject)
  gsub(/[\t\037]/, " ", subj)
  if (subj == "") subj = "(no subject)"
  print n us (st ~ /R/ ? "R" : "U") us sender_of(from, env) us edate us subj
}

{ sub(/\r$/, "") }

prevblank && /^From [^ ]+ +[A-Z][a-z][a-z] [A-Z][a-z][a-z] / {
  finish()
  n++
  env = $2
  edate = $4 " " $5 " " substr($6, 1, 5)
  status = ""; from = ""; subject = ""; date = ""; last = ""
  inheaders = 1
  prevblank = 0
  next
}

{
  prevblank = ($0 == "")

  if (mode == "body") {
    if (n < want) next
    if (n > want) exit
  }

  if (inheaders) {
    if ($0 == "") {
      inheaders = 0
      if (mode == "body") {
        print "From:    " value_of(from)
        print "Date:    " value_of(date)
        print "Subject: " value_of(subject)
        print ""
      }
    } else if ($0 ~ /^[ \t]/) {
      sub(/^[ \t]+/, "")
      if (last == "subject") subject = subject " " $0
      else if (last == "from") from = from " " $0
    } else if (tolower($0) ~ /^status:/)  { status = $0; last = "status" }
    else if (tolower($0) ~ /^from:/)      { from = $0; last = "from" }
    else if (tolower($0) ~ /^subject:/)   { subject = $0; last = "subject" }
    else if (tolower($0) ~ /^date:/)      { date = $0; last = "date" }
    else                                  { last = "" }
    next
  }

  if (mode == "body") print
}

END { finish() }
' "$mbox"
