#!/bin/sh
# Starts a background ticker that re-runs tmux-branch-pr on a fixed interval, so
# a `git checkout` (or a CI run finishing, a review landing, a comment being
# resolved) in a window you then sit still in — with no window/pane event to
# trigger a re-render — still gets picked up within one tick, and stale
# per-branch caches get refreshed even while idle. Single-instance guarded per
# tmux server, and exits with the server that started it (see
# bin/tmux-watchlib): safe to call on every config reload. Mirrors
# bin/tmux-repo-pr-watch.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

INTERVAL=60

# watch_alive as the loop condition, not `while :`, so this exits once the
# tmux server that started it is gone rather than ticking forever.
watch_spawn tmux-branch-pr-watch \
  'while watch_alive; do ~/.dotfiles/bin/tmux-branch-pr; sleep '"$INTERVAL"'; done'
