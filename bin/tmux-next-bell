#!/bin/sh
# Jump to the window in the current session that has waited longest for
# attention with a pending bell (window_bell_flag) — the same signal shown as
# "🔔 name" in status-right (see bin/tmux-notify-windows) and as the 🔔 in the
# choose-tree window list (e.g. Claude Code waiting for input). Windows are
# visited oldest-ring-first — the same @bell_at order status-right lists them
# in, left to right — so repeated presses walk the queue front to back:
# visiting a window clears its bell, dropping it off the front and revealing
# the next. Bound to prefix+n in tmux.conf (repeatable). Shows a brief message
# and stays put when nothing has a bell.
set -eu

sess=$(tmux display-message -p '#{session_name}')

# This session's windows with a pending bell, oldest ring first (ascending
# @bell_at, stamped by bin/tmux-notify-windows). All three fields are single
# tokens (flag 0/1, an epoch or empty, an index), so plain word-splitting is
# safe even though window names are not — the index lets us select the window
# without ever reading its name.
target=$(tmux list-windows -t "$sess" -F '#{window_bell_flag} #{@bell_at} #{window_index}' 2>/dev/null |
  awk '$1 == 1' | sort -k2,2n | awk 'NR == 1 { print $3 }')

if [ -z "$target" ]; then
  tmux display-message 'No windows with a pending notification.'
  exit 0
fi

tmux select-window -t "$sess:$target"
