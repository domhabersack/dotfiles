#!/bin/sh
# Starts a background fswatch watcher that re-runs tmux-obsidian-tasks
# whenever any daily note under TMUX_OBSIDIAN_DAILY_DIR changes.
#
# Single-instance guarded: safe to call multiple times (e.g. on config reload).
# TMUX_OBSIDIAN_DAILY_DIR unset/empty means the feature is disabled: exit
# immediately without starting fswatch.

[ -n "$TMUX_OBSIDIAN_DAILY_DIR" ] || exit 0
DAILY_DIR="$TMUX_OBSIDIAN_DAILY_DIR"
PIDFILE=/tmp/tmux-obsidian-watch.pid
UPDATER=~/.dotfiles/bin/tmux-obsidian-tasks

# Graceful no-op if fswatch is not installed.
command -v fswatch >/dev/null 2>&1 || exit 0

# Single-instance guard — reuse the running watcher if it's still alive.
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  exit 0
fi

# Launch detached. Pass DAILY_DIR via env var to avoid quoting issues with
# a space in the directory name inside a sh -c string. The single quotes
# below are deliberate: $DAILY_DIR/$UPDATER must expand inside the nested
# sh -c, not in this shell.
# -o: batch mode (coalesce rapid saves into one event)
# -e "/Archive/": exclude archive subdirectory
# shellcheck disable=SC2016
DAILY_DIR="$DAILY_DIR" UPDATER="$UPDATER" \
  nohup sh -c \
    'fswatch -o -e "/Archive/" "$DAILY_DIR" | while read -r _; do "$UPDATER"; done' \
  >/dev/null 2>&1 &

echo $! > "$PIDFILE"
