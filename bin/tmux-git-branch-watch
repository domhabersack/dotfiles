#!/bin/sh
# Background ticker that re-stamps every window's @git_branch on a fixed
# interval, so a `git checkout` made in a window you then stay in shows its new
# branch even though no window event (new/rename/select) fired to re-run
# bin/tmux-git-branch-windows. Navigating between windows updates instantly via
# the hooks; this only backstops the "sat still and switched branch" case, so a
# coarse interval is plenty. Single-instance guarded per tmux server, and exits
# with the server that started it (see bin/tmux-watchlib): safe to call on every
# config reload.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

INTERVAL=30

# watch_alive as the loop condition, not `while :`, so this exits once the
# tmux server that started it is gone rather than ticking forever.
watch_spawn tmux-git-branch-watch \
  'while watch_alive; do ~/.dotfiles/bin/tmux-git-branch-windows; sleep '"$INTERVAL"'; done'
