#!/bin/sh
# For each session, list the names of its windows that have a pending bell into
# that session's status-right — a red "🔔 name · name", empty when none — so you
# can tell from any window that another window wants attention without opening
# choose-tree. The bell is the same signal as the 🔔 in the choose-tree window
# list (window_bell_flag; e.g. Claude Code waiting for input) and clears when you
# visit the window.
#
# A window sitting in a linked git worktree gets that worktree’s badge right
# after its name (same look as the status row’s: ◀ name on @badge_bg/@badge_fg,
# see tmux.conf), so "ewi-service" rings as "ewi-service ◀ fix-loop" and two
# windows named after the same repo can be told apart.
#
# Windows are listed oldest-ring-first — left to right in the order they
# started wanting attention — via the @bell_at timestamp stamped below, so
# #{window_index} (which bin/tmux-sort-windows keeps alphabetical) never
# determines this order. prefix+n (bin/tmux-next-bell) reads the same
# @bell_at stamps to cycle the same oldest-first queue.
#
# Per-session: each session's status-right lists only its own windows, so a
# client sees the windows in the session it's attached to. Driven by the
# alert-bell hook (a new bell) and the window-select / -change / -unlink hooks
# (a bell clears when you visit its window, or the window closes), plus once at
# startup — see tmux.conf. status-right is otherwise unused; tmux.conf draws it
# (or @bells_short, its short form below) as the footer's bottom row.
set -eu

now=$(date +%s)

# Stamp every window across all sessions: a newly-ringing window (flag=1, no
# stamp yet) gets "now", fixing its place in the queue at first ring so a
# later re-ring (e.g. Claude Code prompting again before you look) doesn't
# shuffle it to the back. A window whose bell just cleared (flag=0, still
# stamped) has its stamp removed so a future ring starts the queue fresh.
tmux list-windows -a -F '#{window_bell_flag} #{window_id} #{@bell_at}' 2>/dev/null |
while IFS=' ' read -r flag wid stamp; do
  if [ "$flag" = 1 ] && [ -z "$stamp" ]; then
    tmux set-window-option -t "$wid" @bell_at "$now"
  elif [ "$flag" = 0 ] && [ -n "$stamp" ]; then
    tmux set-window-option -t "$wid" -u @bell_at
  fi
done

# Badge colors come from the same options the status row uses, with the same
# defaults as tmux.conf, so a theme that retunes them is followed here too.
badge_bg=$(tmux show-option -gqv @badge_bg 2>/dev/null) || badge_bg=''
badge_fg=$(tmux show-option -gqv @badge_fg 2>/dev/null) || badge_fg=''
badge_bg=${badge_bg:-colour254}
badge_fg=${badge_fg:-colour232}

# shorten <text> <max>: <text> cut to <max> characters with a trailing …, or
# unchanged when it already fits or <max> is 0. Only plain-ASCII text is cut --
# `cut -c` counts bytes rather than characters outside a UTF-8 locale, and
# half a multibyte character renders as garbage, so a name with any other
# character is left whole. The check runs under LC_ALL=C, where a range means
# byte values; in another locale [ -~] can match accented letters too.
shorten() {
  if [ "$2" -eq 0 ] || [ "${#1}" -le "$2" ] ||
    printf '%s' "$1" | LC_ALL=C grep -q '[^ -~]'; then
    printf '%s' "$1"
    return
  fi
  printf '%s…' "$(printf '%s' "$1" | cut -c1-"$(( $2 - 1 ))")"
}

# entries <session> <max>: that session's windows with a pending bell, oldest
# ring first (ascending @bell_at), ' · '-joined, each name and badge shortened
# to <max> characters (0 = in full). Tab-separated so a window name containing
# spaces stays intact when we cut it back out below. Each entry (the name plus
# its worktree badge, if it has one) is wrapped in a range=user marked with its
# window id (e.g. "@12") so a click on either selects that window — see the
# MouseDown1Status binding in tmux.conf. The badge ends by restoring the red
# the entries share with an explicit bg/fg rather than #[default], which would
# otherwise end the red for the rest of the list.
entries() {
  list=$(tmux list-windows -t "$1" -F '#{window_bell_flag}	#{@bell_at}	#{window_id}	#{window_name}	#{@worktree_name}' 2>/dev/null |
    awk -F'	' '$1 == 1' | sort -t'	' -k2,2n | cut -f3- |
    while IFS='	' read -r wid name worktree; do
      printf '#[range=user|%s]%s' "$wid" "$(shorten "$name" "$2")"
      if [ -n "$worktree" ]; then
        printf '#[fg=%s]◀#[bg=%s]#[fg=%s] %s #[bg=default]#[fg=colour1]' "$badge_bg" "$badge_bg" "$badge_fg" "$(shorten "$worktree" "$2")"
      fi
      printf '#[norange] · '
    done)
  printf '%s' "${list% · }"
}

# Two forms per session: status-right in full, and @bells_short with every name
# and badge cut to 10 characters, which the bottom status row shows instead on
# a client narrower than @footer_narrow (see tmux.conf). Narrow, the list gets
# the whole row, so it still runs to several entries before it's clipped -- at
# the right, so it's the newest rings that drop off, never the oldest.
tmux list-sessions -F '#{session_name}' 2>/dev/null | while IFS= read -r sess; do
  names=$(entries "$sess" 0)

  if [ -n "$names" ]; then
    tmux set-option -t "$sess" status-right "#[fg=colour1]🔔 $names#[default]"
    tmux set-option -t "$sess" @bells_short "#[fg=colour1]🔔 $(entries "$sess" 10)#[default]"
  else
    tmux set-option -t "$sess" status-right ''
    tmux set-option -t "$sess" @bells_short ''
  fi
done

# Repaint so a freshly-set indicator shows immediately, not on the next tick.
# `|| true` so a run with no client attached (nothing to repaint) doesn't fail
# the script under `set -e`.
tmux refresh-client -S 2>/dev/null || true
