#!/bin/sh
# Prints two lines for the directory given as $1 (default: the current
# directory), one per window option bin/tmux-worktree-status-windows stamps:
#
#   line 1 (@worktree_here)    "⎇ " (with a trailing space, so it never
#                              collides with the branch name it prefixes)
#                              when $1 sits inside a LINKED worktree of its
#                              repo, empty otherwise (including when $1
#                              isn’t a repo at all, or sits in the main one).
#   line 2 (@worktree_pending) "⎇ N" when $1 sits inside the MAIN worktree
#                              and N other worktrees of that repo still exist
#                              (created by `git-worktree-new`, not yet
#                              cleaned up with `git worktree remove`), empty
#                              otherwise.
#
# A window is either "in a linked worktree" or "in the main worktree with
# outstanding ones to clean up" or neither -- never both -- so the two lines
# are mutually exclusive in practice, but both are always printed (empty or
# not) so a caller can reliably read them positionally.
#
# The "here" signal resolves the main root via bin/git-worktree-root, not
# from `git worktree list --porcelain`’s first record -- that record is the
# COMMON DIR itself, not the working directory, for a submodule or a
# `--separate-git-dir` repo, which would misclassify that repo’s own main
# worktree as "linked" (⎇) here. If git-worktree-root can’t resolve one at
# all (a bare repo with no working tree of its own), $dir is treated as "not
# the main worktree" by omission below, which is the only thing it CAN be in
# that case if it resolves a toplevel at all. The "pending" count doesn’t
# have the same problem -- it only counts how many worktree records exist,
# not which path the main one reports -- so it’s read straight from the
# list; it counts every OTHER record, valid or `prunable` (directory deleted
# but not yet removed) alike, since a prunable entry is exactly "not cleaned
# up yet", the case this signal exists to surface.
set -eu

dir=${1:-.}

git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { printf '\n\n'; exit 0; }

main_root=$("$(dirname "$0")/git-worktree-root" "$dir" 2>/dev/null) || main_root=""
other_count=$(git -C "$dir" worktree list --porcelain | awk '/^worktree /{n++} END{print n-1}')

toplevel=$(git -C "$dir" rev-parse --path-format=absolute --show-toplevel 2>/dev/null) || toplevel=""

here=""
pending=""
if [ -n "$toplevel" ]; then
  if [ -n "$main_root" ] && [ "$toplevel" = "$main_root" ]; then
    [ "$other_count" -gt 0 ] && pending="⎇ $other_count"
  else
    here="⎇ "
  fi
fi

printf '%s\n%s\n' "$here" "$pending"
