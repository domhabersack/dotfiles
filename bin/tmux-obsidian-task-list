#!/bin/sh
# Prints all open (unchecked) tasks from the "## Tasks" section of each
# daily note under TMUX_OBSIDIAN_DAILY_DIR. Read-only reference list for the
# tmux popup bound to `prefix + T` (see tmux.conf) when fzf is unavailable;
# this binding only exists when TMUX_OBSIDIAN_DAILY_DIR is set, but this
# script also guards itself so a direct/manual invocation degrades the same
# way. Extraction itself lives in bin/tmux-obsidian-task-records, which this
# script filters down to open tasks and renders -- see that script for the
# record format.

if [ -z "$TMUX_OBSIDIAN_DAILY_DIR" ]; then
  echo "TMUX_OBSIDIAN_DAILY_DIR is not set"
  exit 0
fi

if [ ! -d "$TMUX_OBSIDIAN_DAILY_DIR" ]; then
  echo "Daily notes folder not found: $TMUX_OBSIDIAN_DAILY_DIR"
  exit 0
fi

us=$(printf '\037')

# Resolved relative to this script's own location, not $HOME -- $HOME is
# only meaningful here as the location of the user's window-colors file
# (read inside tmux-obsidian-task-records), and the two must stay
# independent: tests exercise the window-colors lookup by pointing $HOME at
# a fixture directory, which must not also relocate where sibling scripts
# are found.
bindir=$(dirname "$0")

records=$("$bindir/tmux-obsidian-task-records" | awk -F "$us" '$5 == " "')

if [ -z "$records" ]; then
  echo "No open tasks 🎉"
  exit 0
fi

esc=$(printf '\033')

printf '%s\n' "$records" | awk -F "$us" -v esc="$esc" '
  {
    project = $2; date = $3; text = $4; colour = $6
    if (project != prevproject) {
      if (count > 0) print ""
      printf "%s%s%s[0m\n", esc "[38;5;" colour "m", project, esc
      prevproject = project
    }
    printf "[ ] %s %s\n", date, text
    count++
  }
'
