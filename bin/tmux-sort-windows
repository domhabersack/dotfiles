#!/bin/sh
# Sorts windows alphabetically by their canonical slug (see bin/tmux-window-slug),
# so a leading marker or trailing task suffix never changes a window's position.
# Within windows sharing a slug -- a repo's own window and its worktree
# windows, since bin/tmux-worktree-switch names every worktree window plainly
# after the repo -- the repo's own window sorts first and its worktree
# windows after it, keyed on @worktree_here (bin/tmux-worktree-status):
# non-empty means the window's pane sits in a LINKED worktree rather than the
# repo's main checkout.
# shellcheck source=./tmux-locklib
. "$HOME/.dotfiles/bin/tmux-locklib"

lock=/tmp/tmux-sort-windows.lock
lock_acquire "$lock" || exit 0
release() { rm -rf "$lock"; }
trap release EXIT
trap 'release; exit 130' INT TERM HUP

slug() {
  "$HOME/.dotfiles/bin/tmux-window-slug"
}

# One "<slug> TAB <index> TAB <name> TAB <worktree-flag>" line per window, in
# list-windows order. Slug is computed in ONE pass over every window name
# (not a subprocess per window); the worktree flag comes straight from
# tmux's own -F expansion rather than a second pass over @worktree_here.
snapshot() {
  src=$(mktemp)
  tmux list-windows -F '#{window_index}	#{window_name}	#{?#{@worktree_here},1,0}' > "$src"
  cut -f2 "$src" | slug | paste - "$src"
  rm -f "$src"
}

# The sort key is columns 1 (slug) and 4 (worktree flag) only -- index and
# name ride along unused here so this check stays in lockstep with what the
# reshuffle below actually sorts by.
current=$(snapshot | cut -f1,4 | tr '\n' ' ')
sorted=$(snapshot | sort -t'	' -k1,1 -k4,4 | cut -f1,4 | tr '\n' ' ')
[ "$current" = "$sorted" ] && exit 0

# Remember the window we're on. The reshuffle below can leave the client on a
# different window, and its move-window churn fires select-window hooks that
# would otherwise stamp the wrong window as freshly accessed. tmux-freshness-windows
# skips while our lock is held, so nothing is stamped mid-sort; afterwards we
# reselect this window and trigger one clean render.
active=$(tmux list-windows -F '#{window_active} #{window_id}' | awk '$1 == 1 { print $2; exit }')

tmp=$(mktemp)
snapshot | sort -t'	' -k1,1 -k4,4 > "$tmp"

i=10000
while IFS='	' read -r _ idx _ _; do
  tmux move-window -s ":$idx" -t ":$i" 2>/dev/null
  i=$((i + 1))
done < "$tmp"
rm -f "$tmp"
tmux move-window -r

# Return to the window we started on, then release the lock BEFORE rendering so
# freshness stops skipping — one clean pass restamps the (correct) active window
# and repaints every bar from the timestamps the reshuffle never touched.
[ -n "$active" ] && tmux select-window -t "$active" 2>/dev/null
rm -rf "$lock"
trap - EXIT INT TERM HUP
tmux run-shell -b "$HOME/.dotfiles/bin/tmux-freshness-windows"
