#!/bin/sh
# Background ticker that re-stamps every window’s @worktree_here/
# @worktree_pending on a fixed interval, so a `git worktree add`/`remove` run
# from a window you then stay in (or from outside tmux entirely) updates even
# though no window event (new/rename/select) fired to re-run bin/tmux-worktree-
# status-windows. Navigating between windows updates instantly via the hooks;
# this only backstops the "sat still while the worktree set changed" case, so a
# coarse interval is plenty. Mirrors bin/tmux-git-branch-watch exactly. Single-
# instance guarded per tmux server, and exits with the server that started it
# (see bin/tmux-watchlib): safe to call on every config reload.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

INTERVAL=30

# watch_alive as the loop condition, not `while :`, so this exits once the
# tmux server that started it is gone rather than ticking forever.
watch_spawn tmux-worktree-status-watch \
  'while watch_alive; do ~/.dotfiles/bin/tmux-worktree-status-windows; sleep '"$INTERVAL"'; done'
