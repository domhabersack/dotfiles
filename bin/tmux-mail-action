#!/bin/sh
# Changes one message in the local mailbox for the mail popup
# (bin/tmux-mail-popup):
#
#   tmux-mail-action toggle <line>   mark an unread message read, or a read one
#                                    unread
#   tmux-mail-action delete <line>   delete the message
#
# <line> is the message’s line from bin/tmux-mail-feed exactly as the popup
# showed it. Messages are addressed by position in the mailbox, and a delete (or
# a delivery that lands between the popup’s last refresh and the keypress)
# shifts the positions, so the line is checked against what is at that position
# now and the change is refused, exit 1, when it no longer matches: better a
# "nothing done" than a different message deleted. The popup then reloads and
# shows the mailbox as it is. That check compares the feed with itself, so the
# change is also refused when the feed and mail don't count the same number of
# messages: then their positions don't line up either.
#
# The change itself is made by mail, not by editing the file, and with the
# mailbox opened as the system mailbox ($MAIL), not as a file (-f): only then
# does mail take the flock the delivery agent writes under (postfix here locks
# with flock and a dotlock) when it rewrites the mailbox on quit. With -f it
# takes neither and truncates and rewrites the file regardless, so a message
# delivered during that rewrite is cut off. In mail’s own terms, a message
# counts as read once it has been typed, which is the only way to set that (the
# Status: header gets an R), and `unread` clears it again. `set hold` keeps
# what mail does not delete where it is in the mailbox rather than moving read
# messages to ~/mbox, which is what quitting the system mailbox does otherwise.
# MAILRC=/dev/null keeps the user's own mail settings out of it: with
# autoprint, say, a delete would print the next message too, marking it read.
set -eu

action=${1:?usage: tmux-mail-action toggle|delete <line>}
line=${2:?usage: tmux-mail-action toggle|delete <line>}

feed="$(dirname "$0")/tmux-mail-feed"
mbox=${MAIL:-/var/mail/$(id -un)}
us=$(printf '\037')

# The line’s own fields: only the position and the read state are needed here,
# the rest is just there to be compared.
IFS=$us read -r index state _ <<EOF
$line
EOF

current=$("$feed" | awk -F "$us" -v n="$index" '$1 == n')
isStale=true
[ "$current" = "$line" ] && isStale=false

if [ "$isStale" = true ]; then
  exit 1
fi

# mail's count, from the header line of its last message ("$"). -f only reads
# here: x quits without writing anything back. An empty mailbox prints no
# header line, so counts as 0.
count=$(printf 'from $\nx\n' | MAILRC=/dev/null mail -N -n -f "$mbox" 2>/dev/null |
  awk '{ sub(/^>/, ""); for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/) { print $i; exit } }')
if [ "${count:-0}" != "$("$feed" | wc -l | tr -d ' ')" ]; then
  exit 1
fi

case $action in
  toggle)
    if [ "$state" = U ]; then
      command="type $index"
    else
      command="unread $index"
    fi
    ;;
  delete) command="delete $index" ;;
  *)
    echo "tmux-mail-action: unknown action: $action" >&2
    exit 2
    ;;
esac

# type prints the message; it is only being used for what it records.
printf 'set hold\n%s\nquit\n' "$command" | MAILRC=/dev/null MAIL="$mbox" mail -N -n >/dev/null 2>&1
