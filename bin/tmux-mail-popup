#!/bin/sh
# Interactive tmux popup bound to `prefix + m` and to a click on the 📧 entry
# (see tmux.conf): an fzf list of every message in the local mailbox, newest
# first, unread ones bold with a ●, the highlighted message’s text in the
# preview pane. Backed by bin/tmux-mail-feed, with changes made through
# bin/tmux-mail-action. Falls back to plain `mail` when fzf isn’t available, so
# the popup degrades instead of breaking -- the lookup happens here, at runtime
# inside the popup’s own (non-interactive, non-login) shell, rather than in
# tmux.conf, because that shell’s PATH is not the interactive PATH fzf normally
# lives on (see bin/tmux-obsidian-task-picker, which does the same).
#
# Keys: space/enter mark the highlighted message read, or unread again; ctrl-d
# deletes it; ctrl-r forces a refresh; esc closes the popup. Reading a message
# in the preview never marks it read: whether it counts as read is up to you.
#
# Refresh: fzf’s every(5) runs `--poll`, which reloads the list only if the
# mailbox actually changed, so a message that arrives while the popup is open
# shows up on its own -- see bin/tmux-obsidian-task-poll for why the gate
# matters. After every change the footer indicator is re-rendered at once
# (bin/tmux-mail-status) instead of waiting for its next tick.
#
# The other modes are this script calling itself from fzf’s bindings:
#   --list         the list, in fzf’s input format
#   --poll         an fzf action: reload if the mailbox changed, else ignore
#   --act ACT LINE an fzf action: apply ACT (toggle|delete) to the message on
#                  LINE (as fzf has it) and then reload
set -eu

bindir=$(cd "$(dirname "$0")" && pwd)
self="$bindir/tmux-mail-popup"
feed="$bindir/tmux-mail-feed"
action="$bindir/tmux-mail-action"
status="$bindir/tmux-mail-status"
changed="$bindir/tmux-mail-changed"

mbox=${MAIL:-/var/mail/$(id -un)}
us=$(printf '\037')

# Every line fzf has is the message’s display text, then the feed line it came
# from: fzf shows only the first field, and hands the lot back to the bindings
# below, so they can name the message exactly as the feed gave it. Newest first.
list() {
  "$feed" | sort -rn | awk -F "$us" -v us="$us" '
    BEGIN { esc = sprintf("%c", 27) }
    {
      isUnread = ($2 == "U")
      style = isUnread ? esc "[1m" : esc "[2m"
      marker = isUnread ? "●" : " "
      printf "%s%s %-12.12s %-12s %s%s%s%s\n", style, marker, $3, $4, $5, esc "[0m", us, $0
    }
  '
}

case "${1:-}" in
  --list)
    list
    exit 0
    ;;

  --poll)
    stampfile=${TMUX_MAIL_POLL_STAMP:-/tmp/tmux-mail-poll.stamp}

    # Never fight someone mid-keystroke.
    if [ "${FZF_IDLE_TIME_MS:-9999}" -lt 400 ]; then
      echo ignore
      exit 0
    fi

    # Size and time rather than reading the mailbox, the same check as the
    # footer's ticker (see bin/tmux-mail-changed).
    if ! "$changed" "$stampfile"; then
      echo ignore
      exit 0
    fi

    echo "reload-sync($self --list)"
    exit 0
    ;;

  --act)
    stampfile=${TMUX_MAIL_POLL_STAMP:-/tmp/tmux-mail-poll.stamp}
    line=${3#*"$us"}

    # The reload below shows the result either way; a refusal also says so on
    # the status line, so the "nothing happened" case isn’t silent. Not with
    # fzf's bell: a BEL from inside a display-popup never reaches the terminal.
    reply="reload-sync($self --list)"
    if ! "$action" "$2" "$line"; then
      tmux display-message -d 3000 'Mailbox changed; nothing done' 2>/dev/null || true
    fi

    # Our own change must not read as a mailbox change to the next poll, or the
    # list would reload twice.
    "$changed" "$stampfile" || true
    "$status" --force || true
    echo "$reply"
    exit 0
    ;;
esac

fzf=""
if command -v fzf >/dev/null 2>&1; then
  fzf=$(command -v fzf)
elif [ -x "$HOME/.fzf/bin/fzf" ]; then
  fzf="$HOME/.fzf/bin/fzf"
fi

if [ -z "$fzf" ]; then
  # As the system mailbox with hold set, for the same reason as
  # bin/tmux-mail-action: the lock, and nothing moved to ~/mbox. MAILRC
  # replaces the user's own rc file, so that is sourced first -- quoted, or a
  # path with a space in it fails to source and hold is never set.
  userrc=${MAILRC:-$HOME/.mailrc}
  rc=$(mktemp "${TMPDIR:-/tmp}/tmux-mail-rc.XXXXXX")
  trap 'rm -f "$rc"' EXIT
  trap 'exit 1' HUP INT TERM
  [ -f "$userrc" ] && printf 'source "%s"\n' "$userrc" > "$rc"
  printf 'set hold\n' >> "$rc"
  MAILRC=$rc MAIL=$mbox mail || { echo 'No mail'; sleep 2; }
  exit 0
fi

# Per-invocation state, so two popups open at once never share a stamp. Cleaned
# up on exit -- the trap must run after fzf exits, so this script must not exec
# fzf.
stampfile=$(mktemp "${TMPDIR:-/tmp}/tmux-mail-poll.XXXXXX")
trap 'rm -f "$stampfile"' EXIT
# Closing the popup hangs up on this script; exiting turns that into the trap
# above.
trap 'exit 1' HUP INT TERM
export TMUX_MAIL_POLL_STAMP="$stampfile"
"$changed" "$stampfile" || true

# --id-nth is the sender, date and subject, not the position: a delete shifts
# every later message’s position, and the cursor has to stay on the same message.
list | "$fzf" \
  --ansi --delimiter="$us" --with-nth=1 --no-sort \
  --track --id-nth=4,5,6 \
  --layout=reverse --header-first --highlight-line --cycle \
  --prompt='mail> ' --info=inline-right \
  --header='space/enter toggle read · ctrl-d delete · ctrl-r refresh · esc close' \
  --preview="$feed --body {2}" --preview-window='right,55%,wrap' \
  --bind="space:transform:$self --act toggle {}" \
  --bind="enter:transform:$self --act toggle {}" \
  --bind="ctrl-d:transform:$self --act delete {}" \
  --bind="ctrl-r:reload-sync($self --list)" \
  --bind="every(5):bg-transform:$self --poll" \
  --bind='esc:abort' || true
