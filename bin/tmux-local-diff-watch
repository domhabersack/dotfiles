#!/bin/sh
# Background ticker that re-stamps @local_diff on a fixed interval, so edits
# made in a window you then stay in are reflected even though no tmux event
# (window/pane select, new window) fired to re-run bin/tmux-local-diff-windows.
# Navigating between windows updates instantly via the hooks; this backstops the
# "sat still and kept typing" case, which for this feature is the normal one
# rather than the edge case.
#
# 30s rather than the 60s the PR watchers use: line counts move with every save,
# so a minute-old number reads as wrong in a way a minute-old PR status doesn't.
# Still cheap -- one `git diff` per attached session's active window.
# Single-instance guarded per tmux server, and exits with the server that
# started it (see bin/tmux-watchlib): safe to call on every config reload.

# shellcheck source=./tmux-watchlib
. "$HOME/.dotfiles/bin/tmux-watchlib"

INTERVAL=30

# watch_alive as the loop condition, not `while :`, so this exits once the
# tmux server that started it is gone rather than ticking forever.
watch_spawn tmux-local-diff-watch \
  'while watch_alive; do ~/.dotfiles/bin/tmux-local-diff-windows; sleep '"$INTERVAL"'; done'
