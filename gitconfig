[alias]
  llog = log --all --graph --date=local --pretty=format:'%C(yellow)%h%Cred%d %Cgreen%ad (%ar) %Creset[%C(cyan)%an%Creset]%n        %s'
[color]
  ui = true
[color "branch"]
  current = yellow
  remote = red
[color "decorate"]
  branch = yellow
  remoteBranch = red
  tag = green
  stash = blue
  HEAD = cyan
[color "diff"]
  whitespace = red reverse
[color "status"]
  branch = yellow
  changed = yellow
[core]
  excludesfile = ~/.gitignore_global
  # use delta if installed (brew install git-delta), else fall back to plain output
  pager = if command -v delta >/dev/null 2>&1; then delta; else less; fi
[interactive]
  diffFilter = if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi
[delta]
  navigate = true
[credential]
  helper = osxkeychain
[push]
  default = simple
[pull]
  ff = only
[remote "origin"]
  prune = true
[init]
  defaultBranch = main
[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
[include]
  path = ~/.gitconfig.local
